{
  "description": "Restore learn-wiki learning context when a session starts, resumes, clears, or compacts.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/session_start.py\" 2>/dev/null || python \"${CLAUDE_PLUGIN_ROOT}/hooks/session_start.py\" 2>/dev/null || py \"${CLAUDE_PLUGIN_ROOT}/hooks/session_start.py\" 2>/dev/null || true",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
